# Default text handling
* text=auto

# Source / config files
*.cs        text eol=lf
*.shader    text eol=lf
*.hlsl      text eol=lf
*.compute   text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.asmdef    text eol=lf
*.asmref    text eol=lf

# Unity YAML files
*.unity     text eol=lf
*.prefab    text eol=lf
*.asset     text eol=lf
*.meta      text eol=lf

# Documentation
*.md        text eol=lf
*.txt       text eol=lf

# Binary assets
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.mp3       binary
*.wav       binary
*.ogg       binary
*.fbx       binary
*.psd       binary